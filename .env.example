# Copy this file to .env and adjust. Only variables prefixed with VITE_ are exposed to the browser.
# Never put secrets (API keys, DB passwords) here - everything in the frontend is public.

# App name shown in the UI
VITE_APP_NAME=React Starter

# Backend REST API base URL. Leave empty to run in MOCK mode (no backend needed).
VITE_API_URL=

# Socket.IO server URL (optional). Leave empty to disable real-time features.
VITE_SOCKET_URL=
